@using SteamAuth

@inject Services.SteamGuardTimerService GuardTimer
@inject IJSRuntime JS
@inject ILogger<AccountCard> Logger

<div class="card w-100 shadow-sm @(Selected ? "border-primary border-bold shadow" : "border-bold")"
@onclick="OnCardClick">

    <div class="card-body p-2">

        <!-- PC 端 -->
        <div class="d-none d-md-block">

            <!-- 帐号信息 -->
            <div class="mb-2 text-center">
                <div class="fw-bold fs-6">@AccountAlias</div>
                <div class="text-muted small">@Account?.AccountName</div>
            </div>

            <!-- Token -->
            <div class="bg-light rounded-3 p-2 mb-2 border text-center"
            @ref="_tokenElemRef"
            @onclick="OnTokenClick"
            @ondblclick="OnTokenDoubleClick"
            @onmouseleave="OnTokenMouseLeave"
            data-bs-toggle="tooltip"
            data-bs-title="点击复制"
            style="cursor:pointer;">

                <h4 class="card-text mb-0 fw-bold font-monospace text-break">
                    @_loginToken
                </h4>

            </div>

            <!-- 进度条 -->
            <div class="progress" style="height:6px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                role="progressbar"
                aria-valuenow="@(GuardTimer.SecondsUntilChange)"
                aria-valuemin="0"
                aria-valuemax="30"
                style="width:@(GuardTimer.PercentageUntilChange);">
                </div>
            </div>

        </div>

        <!-- 移动端 -->
        <div class="d-block d-md-none">

            <div class="d-flex justify-content-between align-items-center mb-2">

                <!-- 左侧账号 -->
                <div class="me-2 text-truncate" style="width: 40%;">
                    <div class="fw-bold fs-6">@AccountAlias</div>
                    @* <div class="text-muted small text-truncate">@Account?.AccountName</div> *@
                    <!-- AccountName（只有 Selected 才滚动，否则正常显示）-->
                    @if (Selected)
                    {
                        <div class="text-muted small scrolling-text">
                            @Account?.AccountName
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small text-truncate">
                            @Account?.AccountName
                        </div>
                    }
                </div>

                <!-- Token -->
                <div class="bg-light rounded-3 p-2 border flex-fill text-center"
                    @ref="_tokenElemRef"
                    @onclick="OnTokenClick"
                    @ondblclick="OnTokenDoubleClick"
                    @onmouseleave="OnTokenMouseLeave"
                    data-bs-toggle="tooltip"
                    data-bs-title="点击复制"
                    style="cursor:pointer;">

                    <h5 class="card-text mb-0 fw-bold font-monospace text-break">
                        @_loginToken
                    </h5>

                </div>

            </div>

            <!-- 进度条 -->
            <div class="progress" style="height:4px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                role="progressbar"
                aria-valuenow="@(GuardTimer.SecondsUntilChange)"
                aria-valuemin="0"
                aria-valuemax="30"
                style="width:@(GuardTimer.PercentageUntilChange);">
                </div>
            </div>

        </div>

    </div>
</div>


@code {
    [Parameter]
    public SteamGuardAccount? Account { get; set; } = null!;

    [Parameter]
    public string? AccountAlias { get; set; } = null;

    [Parameter] 
    public string? Password { get; set; } = null;

    [Parameter]
    public bool Selected { get; set; } = false;

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter] 
    public EventCallback<(string accountName, string newPassword)> PasswordChanged { get; set; }

    private ElementReference _tokenElemRef;

    private string _loginToken = "XXXXX";
    private int _currentProgress = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeTooltips");
        }

        if (Selected)
        {
            try
            {
                await JS.InvokeVoidAsync("initScrollingText");
            }
            catch (Exception ex)
            {
                Logger.LogWarning($"{ex.Message}");
            }
        }
    }

    #region 点击复制
    private CancellationTokenSource? _clickCts;

    private async Task OnTokenClick()
    {
        // 取消上一次待处理的单击
        _clickCts?.Cancel();
        _clickCts = new ();

        try
        {
            // 等 250 ms，如果期间又被点了，就抛异常走不到后面
            await Task.Delay(250, _clickCts.Token);

            // 真正单击
            await JS.InvokeVoidAsync("copyToClipboard", _loginToken);
            await JS.InvokeVoidAsync("updateTooltipContent", _tokenElemRef, "已复制");
        }
        catch (OperationCanceledException)
        {
            // 双击来了，单击被取消，什么都不做
        }
    }

    private async Task OnTokenDoubleClick()
    {
        try
        {
            // 双击立即取消单击计时器
            _clickCts?.Cancel();
            await JS.InvokeVoidAsync("copyToClipboard", $"{Account?.AccountName} {Password} {_loginToken}");
            await JS.InvokeVoidAsync("updateTooltipContent", _tokenElemRef, "已复制");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Error copying text: {ex.Message}");
        }
    }

    private async Task OnTokenMouseLeave()
    {
        try
        {
            await JS.InvokeVoidAsync("updateTooltipContent", _tokenElemRef, "点击复制");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Error updating tooltip: {ex.Message}");
        }
    }
    #endregion

    #region 自动更新令牌
    protected override void OnInitialized()
    {
        GuardTimer.OnTickAsync += UpdateStateAsync;
    }

    public void Dispose()
    {
        GuardTimer.OnTickAsync -= UpdateStateAsync;
    }

    private async Task UpdateStateAsync()
    {
        _loginToken = Account?.GenerateSteamGuardCodeForTime(GuardTimer.SteamTime) ?? "XXXXX";
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCardClick()
    {
        await OnClick.InvokeAsync(null);
    }
    #endregion
}