@using SteamAuth

@inject Services.SteamGuardTimerService GuardTimer
@inject IJSRuntime JS
@inject ILogger<AccountCard> Logger

<div class="card text-center shadow-sm @(Selected ? "border-primary shadow" : "border-light")" @onclick="OnCardClick" style="max-width: 28rem; border-width: 2px; border-radius: 1rem; transition: all 0.3s ease;">
    <div class="card-body p-4">
        <h5 class="card-title mb-3 fw-bold">@Account?.AccountName</h5>

        <div class="mb-3">
            <input type="password"
                   class="form-control form-control-sm"
                   placeholder="密码"
                   @bind="_password"
                   @onfocusout="SavePassword" />
        </div>

        <div class="bg-light rounded-3 p-3 mb-3" style="cursor: pointer; transition: all 0.2s ease;" @ref=_tokenElemRef @onclick="OnTokenClick" @ondblclick="OnTokenDoubleClick" @onmouseleave="OnTokenMouseLeave" data-bs-toggle="tooltip" data-bs-title="点击复制">
            <h4 class="card-text mb-0 fw-bold" style="font-family: 'Courier New', monospace; letter-spacing: 0.15em;">@_loginToken</h4>
        </div>
        
        <div>
            <div class="progress" style="height: 8px; border-radius: 0.5rem;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                     role="progressbar"
                     aria-label="Animated striped example"
                     aria-valuenow="@(GuardTimer.SecondsUntilChange)"
                     aria-valuemin="0"
                     aria-valuemax="30"
                     style="width: @(GuardTimer.PercentageUntilChange); border-radius: 0.5rem;"></div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public SteamGuardAccount? Account { get; set; } = null!;

    [Parameter] 
    public string? Password { get; set; } = null;

    [Parameter]
    public bool Selected { get; set; } = false;

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter] 
    public EventCallback<(string accountName, string newPassword)> PasswordChanged { get; set; }

    private ElementReference _tokenElemRef;

    private string _loginToken = "XXXXX";
    private int _currentProgress = 0;
    private string? _password;

    protected override void OnParametersSet()
    {
        _password = Password;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeTooltips");
        }
    }

    #region 点击复制
    private CancellationTokenSource? _clickCts;

    private async Task OnTokenClick()
    {
        // 取消上一次待处理的单击
        _clickCts?.Cancel();
        _clickCts = new ();

        try
        {
            // 等 250 ms，如果期间又被点了，就抛异常走不到后面
            await Task.Delay(250, _clickCts.Token);

            // 真正单击
            await JS.InvokeVoidAsync("copyToClipboard", _loginToken);
            await JS.InvokeVoidAsync("updateTooltipContent", _tokenElemRef, "已复制");
        }
        catch (OperationCanceledException)
        {
            // 双击来了，单击被取消，什么都不做
        }
    }

    private async Task OnTokenDoubleClick()
    {
        try
        {
            // 双击立即取消单击计时器
            _clickCts?.Cancel();
            await JS.InvokeVoidAsync("copyToClipboard", $"{Account?.AccountName} {_password} {_loginToken}");
            await JS.InvokeVoidAsync("updateTooltipContent", _tokenElemRef, "已复制");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Error copying text: {ex.Message}");
        }
    }

    private async Task OnTokenMouseLeave()
    {
        try
        {
            await JS.InvokeVoidAsync("updateTooltipContent", _tokenElemRef, "点击复制");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Error updating tooltip: {ex.Message}");
        }
    }
    #endregion

    #region 自动更新令牌
    protected override void OnInitialized()
    {
        GuardTimer.OnTickAsync += UpdateStateAsync;
    }

    public void Dispose()
    {
        GuardTimer.OnTickAsync -= UpdateStateAsync;
    }

    private async Task UpdateStateAsync()
    {
        _loginToken = Account?.GenerateSteamGuardCodeForTime(GuardTimer.SteamTime) ?? "XXXXX";
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCardClick()
    {
        await OnClick.InvokeAsync(null);
    }
    #endregion

    private async Task SavePassword()
    {
        if (Account?.AccountName == null || string.IsNullOrWhiteSpace(_password) || Password == _password) return;
        await PasswordChanged.InvokeAsync((Account.AccountName, _password));
    }
}